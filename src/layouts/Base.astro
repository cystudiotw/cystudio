---
import JsonLd from '../components/JsonLd.astro';
import { organizationSchema, websiteSchema, siteUrl } from '../lib/schema.js';
const {
  title = '雲橙網頁設計工作室',
  description = '打造可靠的網站營運系統與 API 整合',
  active = '',
  image = '',        // og:image 覆寫（絕對網址；預設用站方合成圖）
  type = 'website',  // og:type（文章頁傳 'article'）
  noindex = false,   // 404 等不該被收錄的頁面
  jsonLd = [],       // 頁面專屬結構化資料（Organization/WebSite 已全站內建）
} = Astro.props;
// 首頁的「作品案例」捲到同頁 #project；其他頁面導向 /catalogue/
const isHome = Astro.url.pathname === '/';
const nav = [['服務項目', '/#service'], ['作品案例', isHome ? '/#project' : '/catalogue/'], ['關於雲橙', '/#about'], ['聯絡我們', '#contact'], ['部落格', '/blog/']];
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image || `${siteUrl}/images/og-image.jpg`;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      (function () {
        try {
          if (document.createElement('canvas').toDataURL('image/webp').indexOf('data:image/webp') === 0) {
            document.documentElement.classList.add('webp');
          }
        } catch (error) { }
      })();
    </script>
    {!noindex && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta name="theme-color" content="#171717" />
    <meta property="og:site_name" content="雲橙網頁設計工作室" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    {type === 'article' && <meta property="article:author" content="Mark Chen" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <JsonLd data={organizationSchema()} />
    <JsonLd data={websiteSchema()} />
    {jsonLd.map((schema) => <JsonLd data={schema} />)}
  </head>
  <body>
    <header id="home_navi" class:list={['site-header', Astro.url.pathname !== '/' && 'inner']}>
      <div class="nav-inner">
        <a class="brand" href="/" aria-label="cystudio 首頁"><picture><source srcset="/images/large-logo.png.webp" type="image/webp"/><img src="/images/large-logo.png" width="140" height="35" alt="cystudio" /></picture></a>
        <button class="menu-toggle" aria-label="選單切換" aria-expanded="false"><span></span><span></span><span></span></button>
        <nav>{nav.map(([label, href]) => <a class={active === label ? 'active' : ''} href={href}>{label}</a>)}</nav>
      </div>
    </header>
    <main><slot /></main>
    <footer id="contact">
      <svg class="footer-shape" aria-hidden="true" viewBox="0 0 2600 131.1" preserveAspectRatio="none"><path d="M0 0L2600 0 2600 69.1 0 0z"/><path opacity=".5" d="M0 0L2600 0 2600 69.1 0 69.1z"/><path opacity=".25" d="M2600 0L0 0 0 130.1 2600 69.1z"/></svg>
      <a class="line-float" href="https://line.me/R/ti/p/@xzw0801n" target="_blank" rel="nofollow"><picture><source srcset="/images/line_logo.png.webp" type="image/webp"/><img src="/images/line_logo.png" width="54" height="54" alt="Line聯絡我" /></picture></a>
      <picture><source srcset="/images/small-logo-w.png.webp" type="image/webp"/><img class="footer-logo" src="/images/small-logo-w.png" width="167" height="50" alt="雲橙工作室" /></picture>
      <div class="footer-meta"><p><a href="mailto:cystudio.tw@gmail.com">cystudio.tw@gmail.com</a></p><p>Line <a href="https://line.me/R/ti/p/@xzw0801n" target="_blank" rel="noopener">xzw0801n</a></p><p>統一編號 82601473</p></div>
      <small class="copyright">© cystudio 雲橙工作室 {new Date().getFullYear()}</small>
    </footer>
    <script>
      const island = document.getElementById('home_navi');
      const button = document.querySelector('.menu-toggle');
      const menu = island?.querySelector('nav');
      const updateIsland = () => island?.classList.toggle('custom-island', window.scrollY > 50);
      updateIsland();
      window.addEventListener('scroll', updateIsland, { passive: true });
      button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') !== 'true'; button.setAttribute('aria-expanded', String(open)); menu?.classList.toggle('open', open); });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { button?.setAttribute('aria-expanded', 'false'); menu.classList.remove('open'); }));
      const filterButtons = [...document.querySelectorAll('[data-project-filter]')];
      const projectCards = [...document.querySelectorAll('.project-card[data-catalogues]')];
      filterButtons.forEach((filter) => filter.addEventListener('click', () => {
        const selected = filter.dataset.projectFilter;
        filterButtons.forEach((item) => item.classList.toggle('active', item === filter));
        projectCards.forEach((card) => { card.hidden = selected !== 'all' && !card.dataset.catalogues.split(' ').includes(selected); });
      }));
      const counters = document.querySelectorAll('.counter[data-to]');
      const animateCounter = (element) => {
        if (element.dataset.animated) return;
        element.dataset.animated = 'true';
        const from = Number(element.dataset.from || 0);
        const to = Number(element.dataset.to || 0);
        const start = performance.now();
        const tick = (now) => {
          const progress = Math.min((now - start) / 2000, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const value = from + (to - from) * eased;
          element.textContent = Number.isInteger(to) ? Math.round(value).toString() : value.toFixed(2);
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { animateCounter(entry.target); observer.unobserve(entry.target); } }), { threshold: 0.35 });
        counters.forEach((counter) => observer.observe(counter));
      } else counters.forEach(animateCounter);
    </script>
  </body>
</html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700;800&display=swap');
:root{font-family:'Noto Sans TC',sans-serif;color:#222;background:#fff;font-synthesis:none;text-rendering:optimizeLegibility;--orange:#f5a623;--ink:#171717;--muted:#777}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}.site-header{position:absolute;z-index:5;left:0;right:0;top:0;height:76px;padding:0 max(calc((100vw - 1240px)/2),6%);display:flex;align-items:center;justify-content:space-between;color:white}.brand{font-size:30px;font-style:italic;font-weight:800;color:var(--orange);letter-spacing:-1.5px}.site-header nav{display:flex;gap:38px;font-size:15px;font-weight:600}.site-header nav a:hover,.site-header nav .active{color:var(--orange)}.menu-toggle{display:none;background:none;border:0;color:white;font-size:26px}.eyebrow{font-weight:700;letter-spacing:3px;color:var(--orange);font-size:13px}.button{display:inline-flex;gap:14px;align-items:center;background:var(--orange);color:#fff;border-radius:99px;padding:13px 24px;font-weight:700;font-size:14px}.button:hover{background:#e69512}.page-hero{padding:142px 24px 75px;background:var(--ink);color:white;text-align:center}.page-hero h1{font-size:clamp(34px,5vw,62px);margin:12px auto 14px}.page-hero p{color:#ccc;margin:0 auto;max-width:660px}.content-wrap{max-width:1180px;margin:auto;padding:72px 24px 100px}.section-title{text-align:center;margin:0 0 38px}.section-title .eyebrow{display:block;margin-bottom:10px}.section-title h2{font-size:36px;margin:0}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}.card{display:block;background:white;border:1px solid #eee;transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-5px);box-shadow:0 14px 35px #00000012}.card-image{display:block;width:100%;aspect-ratio:1.55;object-fit:cover;background:#eee}.card-copy{padding:20px}.card-copy h2,.card-copy h3{font-size:19px;margin:0 0 9px}.card-copy p{color:var(--muted);font-size:14px;line-height:1.8;margin:0}.meta{color:var(--muted);font-size:13px;margin-bottom:10px}.filters{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin:-8px 0 36px}.filters a{border:1px solid #ddd;border-radius:99px;padding:8px 17px;font-size:14px}.filters a:hover,.filters a.active{background:var(--orange);border-color:var(--orange);color:#fff}.article{max-width:850px;margin:auto}.article h1{font-size:clamp(32px,5vw,54px);line-height:1.35}.article .cover{width:100%;max-height:540px;object-fit:cover;margin:25px 0}.article-body{font-size:17px;line-height:2;color:#343434;overflow-wrap:anywhere}.article-body img{max-width:100%;height:auto}.article-body h2,.article-body h3{color:#171717;line-height:1.5;margin-top:2em}.article-body a{color:#c47a00;text-decoration:underline}footer{background:#171717;color:#fff;padding:74px max(calc((100vw - 1180px)/2),6%) 30px;display:grid;grid-template-columns:1.3fr 1fr;gap:40px}footer h2{font-size:34px;margin:12px 0 24px}.footer-meta{justify-self:end;color:#aaa;font-size:14px;line-height:2}.footer-meta small{font-size:12px}.empty{padding:70px 24px;text-align:center;color:var(--muted)}@media(max-width:760px){.site-header{height:64px;padding:0 22px}.brand{font-size:27px}.menu-toggle{display:block}.site-header nav{display:none;position:absolute;top:64px;left:0;right:0;padding:16px 24px 24px;background:#191919;flex-direction:column;gap:0}.site-header nav.open{display:flex}.site-header nav a{padding:12px 0}.cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.card-copy{padding:15px}.card-copy h2,.card-copy h3{font-size:16px}.content-wrap{padding:54px 18px 76px}.section-title h2{font-size:29px}.page-hero{padding-top:116px}footer{grid-template-columns:1fr;padding:54px 24px 26px}footer h2{font-size:28px}.footer-meta{justify-self:start}}@media(max-width:440px){.cards{grid-template-columns:1fr}}
</style>
<style is:global>
/* Cystudio layout: reproduce the current Elementor shared header/footer behaviour. */
#home_navi{position:fixed!important;top:0!important;left:0!important;right:0!important;width:100%!important;z-index:99998!important;margin:0 auto!important;box-sizing:border-box!important;transition:all .35s cubic-bezier(.16,1,.3,1)!important;background:transparent;border:1px solid transparent;box-shadow:none}
#home_navi::before{display:none!important}
#home_navi .nav-inner{position:relative;isolation:isolate;height:66px;width:min(100% - 40px,660px);max-width:660px;margin:auto;padding:0;display:flex;align-items:center;justify-content:space-between;gap:28px;transition:height .3s ease,width .3s ease,padding .3s ease,gap .3s ease}
#home_navi .nav-inner::before{content:"";position:absolute;inset:0;z-index:-1;border-radius:999px;background:rgba(26,26,28,.6);border:1px solid rgba(255,255,255,.15);box-shadow:0 12px 32px rgba(0,0,0,.45);-webkit-backdrop-filter:blur(16px) saturate(180%);backdrop-filter:blur(16px) saturate(180%);opacity:0;transition:opacity .22s ease;pointer-events:none}
#home_navi .brand img{display:block;width:140px;height:35px;object-fit:contain}
#home_navi nav{display:flex;align-items:center;justify-content:flex-end;gap:24px;flex:0 0 auto;white-space:nowrap;font-size:16px;font-weight:500}
#home_navi .brand{flex:0 0 140px}
#home_navi nav a{color:#fff}
#home_navi nav a:hover,#home_navi nav a.active{color:#f49d15}
#home_navi.inner:not(.custom-island){background-color:rgba(51,51,51,.82)}
@media(min-width:768px){#home_navi.custom-island{top:0!important;left:0!important;right:0!important;transform:none!important;width:100%!important;max-width:100%!important;background:transparent!important;border-color:transparent!important;box-shadow:none!important}#home_navi.custom-island .nav-inner{height:66px;width:max-content;max-width:calc(100% - 40px);margin:auto;padding:0 30px;gap:34px;justify-content:center}#home_navi.custom-island .nav-inner::before{opacity:1}#home_navi.custom-island nav{gap:20px;font-size:14px}}
@media(max-width:767px){#home_navi{top:0!important;width:100%!important;max-width:100%!important;border-radius:0!important;border:0!important;box-shadow:none!important;background:transparent!important;padding:12px 0!important;transition:background-color .3s ease!important;transform:none!important;animation:none!important}#home_navi .nav-inner{height:36px;width:100%;max-width:100%;padding:0 20px;display:flex;flex-direction:row;justify-content:space-between;align-items:center;flex-wrap:nowrap;gap:0}#home_navi .nav-inner::before{display:none}#home_navi.inner:not(.custom-island){background:rgba(51,51,51,.82)!important}#home_navi.custom-island{top:0!important;background:#333!important;background-color:rgba(51,51,51,.9)!important;-webkit-backdrop-filter:blur(10px)!important;backdrop-filter:blur(10px)!important}#home_navi .brand{flex:0 0 auto}#home_navi nav{display:none;position:fixed;top:64px;left:0;right:0;width:100vw;max-width:100vw;margin:0;background:rgba(51,51,51,.86);-webkit-backdrop-filter:blur(10px) saturate(150%);backdrop-filter:blur(10px) saturate(150%);box-shadow:0 15px 30px rgba(0,0,0,.28);flex-direction:column;gap:0;white-space:normal}#home_navi nav.open{display:flex}#home_navi nav a{display:block;width:100%;padding:14px 20px;text-align:center;border-bottom:1px solid rgba(255,255,255,.19)}#home_navi nav a:last-child{border-bottom:0}.menu-toggle{display:flex;flex-direction:column;justify-content:center;gap:5px;width:38px;height:38px;padding:7px;border:0;background:transparent}.menu-toggle span{display:block;height:2px;width:100%;background:#fff;transition:transform .2s,opacity .2s}.menu-toggle[aria-expanded=true] span:first-child{transform:translateY(7px) rotate(45deg)}.menu-toggle[aria-expanded=true] span:nth-child(2){opacity:0}.menu-toggle[aria-expanded=true] span:last-child{transform:translateY(-7px) rotate(-45deg)}}
.hero{min-height:100vh;margin-top:-55px;padding:140px 24px 130px;overflow:hidden}html.webp .hero{background-image:url('/images/space.jpg.webp')}.hero-collage{display:none}.hero:after{display:none}.hero-curve{position:absolute;z-index:2;bottom:-1px;left:0;width:100%;height:100px;fill:#fff}.hero-copy{z-index:3}
.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;margin:40px 0}.service-card{display:block;padding:30px 15px;border:1px solid #e0e0e0;border-radius:20px;background:rgba(255,255,255,.63);box-shadow:5px 5px 10px rgba(0,0,0,.1);min-height:190px;color:#222}.service-card:hover{box-shadow:5px 7px 16px rgba(0,0,0,.16)}.service-card h3{margin:20px 0 10px;font-size:1.3em;line-height:1.2;color:var(--orange)}.service-card p{margin:0;font-size:15px;line-height:1.8;color:#555}.service-logo{display:block;width:75px;height:60px;object-fit:contain}.service-card.featured{background:rgba(255,255,255,.63);color:#222}
.project-tags{gap:0;margin:0 auto 25px}.project-tags button{appearance:none;background:transparent;border:0;padding:10px 15px;color:#444;font:inherit;cursor:pointer}.project-tags button.active,.project-tags button:hover{color:var(--orange)}.project-grid{grid-template-columns:repeat(6,minmax(0,1fr));gap:20px}.project-card{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;background:#eee}.project-card[hidden]{display:none}.project-card img{width:100%;height:100%;aspect-ratio:auto;object-fit:cover;display:block;transition:transform .3s}.project-card:hover img{transform:scale(1.035)}.project-card .project-overlay{position:absolute;inset:0;display:grid;place-items:center;background:rgba(0,0,0,.65);opacity:0;transition:opacity .2s;padding:15px}.project-card:hover .project-overlay,.project-card:focus-visible .project-overlay{opacity:1}.project-overlay h3{margin:0;color:#fff;text-align:center;font-size:16px;font-weight:500}
.about{max-width:1180px;padding:70px 24px 100px;grid-template-columns:1fr 1fr;align-items:center;gap:30px}.about-copy h2{font-size:36px;margin:10px 0 20px}.about-copy h3{font-size:18px}.about-copy p{font-size:15px;line-height:1.8;color:#444}.stats{margin-left:-25px;margin-right:25px;padding:50px;background:#efefef;border-radius:20px;box-shadow:0 0 20px rgba(0,0,0,.1);grid-template-columns:repeat(2,minmax(0,1fr));gap:5% 2%}.stats .stat{position:relative;min-width:0;padding:5px 0 12px;background:transparent;display:grid;grid-template-columns:auto auto;justify-content:start;align-items:baseline;column-gap:5px}.stat-title{grid-column:1/-1;font-size:15px;font-weight:500}.stat .counter{font-size:36px;line-height:1.2;color:var(--orange);font-weight:600}.stat .suffix{font-size:16px;color:#333}.stat p{grid-column:1/-1;margin:6px 0 0;font-size:13px;line-height:1.7;color:#555}
footer{position:relative;margin-top:50px;padding:100px 24px 25px;min-height:310px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:6px;text-align:center;background:linear-gradient(180deg,#1e3255 0%,#01040d 100%);color:#fff}footer .footer-shape{position:absolute;top:0;left:0;width:100%;height:80px;fill:#fff}footer .footer-logo{display:block;width:167px;height:50px;object-fit:contain;margin:0 auto 4px}footer .footer-meta{justify-self:auto;color:#fff;font-size:15px;line-height:1.5}footer .footer-meta p{margin:5px 0}footer .copyright{font-size:14px;margin-top:6px;color:#fff}footer .line-float{position:fixed;z-index:9999;right:15px;bottom:15px;width:54px;height:54px}footer .line-float img{display:block;width:54px;height:54px}
@media(max-width:1024px){.project-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.about{gap:20px}.stats{margin-left:-10px;margin-right:0;padding:30px}}
@media(max-width:767px){.service-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.about{grid-template-columns:1fr;gap:18px;padding:55px 24px 75px}.stats{margin:0;padding:24px}.hero{min-height:100vh;padding-top:125px}.hero-curve{height:70px}footer{margin-top:50px;padding:90px 20px 25px}}
@media(max-width:440px){.service-grid{grid-template-columns:1fr}.project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.project-overlay h3{font-size:13px}.stats{padding:18px;gap:16px 8px}.stat .counter{font-size:30px}}
footer .footer-meta a{color:#f49d15}footer .footer-meta a:hover{color:#ffc15a}
body{min-height:100vh;min-height:100dvh;display:flex;flex-direction:column}body>main{flex:1 0 auto;width:100%}
</style>
