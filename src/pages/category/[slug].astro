---
import Base from '../../layouts/Base.astro';
import { getCategories, getPosts, clean, excerptOf, dateOf, routeSlug, tryOr } from '../../lib/wordpress.js';
import { collectionSchema, breadcrumbSchema, siteUrl } from '../../lib/schema.js';
export async function getStaticPaths(){const categories=await tryOr(getCategories(), []);return categories.map(category=>({params:{slug:routeSlug(category.slug)},props:{category}}));}
const {category}=Astro.props;
const posts=(await tryOr(getPosts(), [])).filter(post=>(post.categories||[]).includes(category.id));
const pageUrl=new URL(Astro.url.pathname, Astro.site).toString();
const description=`${category.name}分類的文章（${posts.length} 篇）：雲橙工作室的網站開發、系統設計與 SEO 實戰分享。`;
---
<Base title={`${category.name} - 雲橙網頁設計工作室`} description={description} active="部落格" jsonLd={[
  collectionSchema({
    title: `${category.name}｜雲橙工作室部落格`,
    description,
    url: pageUrl,
    items: posts.map((post) => ({ name: clean(post.title?.rendered), url: `${siteUrl}/blog/${routeSlug(post.slug)}/` })),
  }),
  breadcrumbSchema([
    { name: '首頁', url: `${siteUrl}/` },
    { name: '部落格', url: `${siteUrl}/blog/` },
    { name: category.name, url: pageUrl },
  ]),
]}>
  <section class="blog-archive">
    <div class="breadcrumbs"><a href="/">首頁</a><span>/</span><a href="/blog/">部落格</a><span>/</span><span>{category.name}</span></div>
    {posts.length?<div class="post-list">{posts.map((post)=><article class="post-summary"><h2><a href={`/blog/${routeSlug(post.slug)}/`} set:html={post.title?.rendered}/></h2><div class="post-meta"><time datetime={post.date}>{dateOf(post)}</time><span>{(post.comment_count||0)>0?`${post.comment_count} 則留言`:'尚無留言'}</span></div><p>{excerptOf(post)}</p><a class="read-more" href={`/blog/${routeSlug(post.slug)}/`}>閱讀更多 »</a></article>)}</div>:<p class="empty">目前沒有文章。</p>}
  </section>
</Base>
<style>
.blog-archive{max-width:1180px;min-height:50vh;margin:0 auto;padding:100px 20px 55px}.breadcrumbs{display:flex;gap:12px;color:#777;font-size:14px;margin-bottom:28px}.breadcrumbs a:hover,.breadcrumbs>:last-child{color:var(--orange)}.post-list{display:grid;grid-template-columns:1fr;gap:35px}.post-summary{padding:0 0 24px;border-bottom:1px solid #eee}.post-summary h2{margin:0 0 12px;font-size:24px;line-height:1.45}.post-summary h2 a:hover,.read-more:hover{color:var(--orange)}.post-meta{display:flex;gap:18px;margin-bottom:15px;color:#888;font-size:13px}.post-summary p{margin:0 0 8px;line-height:1.8;color:#555}.read-more{font-size:14px;color:var(--orange)}@media(max-width:767px){.blog-archive{padding:85px 20px 40px}.post-summary h2{font-size:20px}}
</style>
