---
import Base from '../layouts/Base.astro';
import { getProjects, getCatalogues, termsOf, thumbOf, clean, webpOf } from '../lib/wordpress.js';
let projects = [];
try { projects = await getProjects(); } catch (error) { console.warn(error.message); }
const catalogues = await getCatalogues().catch(() => []);
// 執業年數：2013 年開始執業，build 時自動計算（配合每日自動重建，跨年後第一次重建即 +1）
const years = new Date().getFullYear() - 2013;
const services = [
  ['舊站翻新與轉換率健檢', '網站有流量卻留不住客人？載入卡頓、手機版按鈕難點、表單繁瑣，常在細節中悄悄推走訂單。我們從「載入效能、行動體驗與結帳漏斗」深入診斷，找出流失盲點並針對性重構，把流失的流量轉化為真實營收。','/images/services/service-1.svg'],
  ['高轉換電商架構', '支援 WooCommerce 與獨立客製電商架構。我們不僅打造穩定商城，更協助分析購物漏斗中的流失斷層，針對結帳痛點進行動線修整與效能優化，有效降低購物車放棄率，全面提升每一位造訪者的下單轉換率。','/images/services/service-2.svg'],
  ['企業營運自動化系統', '團隊每天花大量時間手動整理 Excel、複製貼上訂單？套裝軟體流程僵化，無法貼合業務。我們專精打造貼合公司作業流程的內部系統、表單審核與進銷存整合，消滅重複性行政工時，讓團隊專注於創造高營收的核心業務。','/images/services/service-3.svg'],
  ['網站效能升級', '多年未更新的舊網站，正面臨載入過慢與程式老舊的風險。我們協助老舊站點進行 效能優化與介面翻新，消滅行動端操作阻力與卡頓，大幅降低跳出率，讓每一筆行銷預算發揮應有的商業效益。','/images/services/service-4.svg'],
  ['WP 深度客製架構', '拒絕肥大拖速的現成套版與外掛堆疊。我們提供全站自訂版型開發、自製專屬外掛與資料庫輕量化工程，打造後台直覺好維護、前台極速載入且具備高資安防護的企業級 WordPress 網站，兼顧品牌質感與擴充彈性。','/images/services/service-5.svg'],
  ['雲端伺服器與維運託管', '主機當機斷線、SSL 到期、遭遇惡意攻擊時，團隊有能力即時排查嗎？我們提供 Cloudflare 資安防護、VPS 效能調校、自動異地備份演練與障礙即時排查服務。不只是租賃空間，更是為你的線上門面打造不中斷的穩定後盾。','/images/services/service-6.svg'],
  ['SEO / AEO 搜尋與 AI 檢索優化', '不只讓 Google 搜得到，更要讓 ChatGPT、Gemini等 AI 工具精準推薦你的品牌。我們從底層結構化資料、語義標籤、極速載入指標到內容架構完整佈局，搶佔傳統搜尋排名與生成式 AI 時代的流量紅利。','/images/services/service-7.svg'],
  ['成效追蹤與跨平台 API 整合', '廣告投了卻無法追蹤真實成效？我們精準部署 GA4、Meta與 LINE 官方帳號 Webhook 串接。告別瀏覽器阻擋遺失數據的困擾，讓廣告轉換與客戶名單零時差拋轉至內部系統，精準掌握投報率。','/images/services/service-8.svg'],
  ['網域資產與 DNS 安全配置', '網域不只是註冊名稱，更關乎品牌資產與企業信箱信譽。我們協助評估高價值網域名稱、完成 DNSSEC 防劫持設定、配置 DMARC/SPF 防止企業信箱被冒名詐騙，並無縫銜接 Cloudflare 防護，確保品牌數位資產萬無一失。','/images/services/service-9.svg'],
];
---
<Base title="雲橙網頁設計工作室｜打造可靠的網站營運系統與 API 整合" description="雲橙工作室（台中，2013 年成立）提供 WordPress 官網、WooCommerce 購物網站、企業客製系統（進銷存、人事、財會）、SEO／AEO 優化與雲端維運，累積 50+ 商用專案實績。">
  <section class="hero">
    <div class="hero-copy"><p>網站不只做出來，更要跑得穩</p><h1>打造可靠的網站營運系統與 API 整合</h1><div class="intro">擁有 10 年以上架構經驗，我們專注於系統API深度串接，主機資安防禦，高負載效能調優與後端穩定維運，成為你最安心的企業專屬技術長。</div><a class="button" href="#service">↓　瞭解更多</a></div>
    <svg class="hero-curve" aria-hidden="true" viewBox="0 0 1000 100" preserveAspectRatio="none"><path d="M1000,4.3V0H0v4.3C0.9,23.1,126.7,99.2,500,100S1000,22.7,1000,4.3z"/></svg>
  </section>
  <section class="services" id="service"><div class="section-title"><span class="eyebrow">OUR SERVICES</span><h2>商業與系統解決方案</h2></div><div class="service-grid"><a class="service-card" href="https://eccounting.com.tw/" target="_blank" rel="noopener"><picture><source srcset="/images/unnamed.png.webp" type="image/webp"/><img class="service-logo" src="/images/unnamed.png" width="75" height="60" alt="雲記帳智慧財務系統"/></picture><h3>雲記帳智慧財務系統</h3><p>專為創業團隊量身規劃的直覺式記帳平台。打通單據記錄、發票管理到營業稅申報的完整斷層，內建智慧輸入與帳款到期提醒，消除手動登打的遺漏與錯誤，讓繁複的財稅作業轉化為清晰易懂的營運數據。</p></a>{services.map(([title, text, icon]) => <article class="service-card"><span class="service-icon-box"><img class="service-icon" src={icon} alt="" aria-hidden="true"/></span><h3>{title}</h3><p>{text}</p></article>)}</div></section>
  <section class="projects" id="project"><div class="section-title"><span class="eyebrow">OUR PROJECTS</span><h2>作品案例</h2><p>客製化完成不同的需求!</p></div><div class="project-tags"><button class="active" type="button" data-project-filter="all">全部</button>{catalogues.map((term)=><button type="button" data-project-filter={String(term.id)}>{term.name}</button>)}</div><div class="project-grid">{projects.map((item) => { const image = thumbOf(item); const webp = webpOf(image); return <a class="project-card" data-catalogues={termsOf(item, 'catalogue').map((term) => term.id).join(' ')} href={`/project/${item.slug}/`}>{image && <picture>{webp && <source srcset={webp} type="image/webp"/>}<img src={image} alt={clean(item.title?.rendered)} loading="lazy"/></picture>}<div class="project-overlay"><h3 set:html={item.title?.rendered}/></div></a>; })}</div></section>
  <section class="about" id="about"><div class="section-title about-title"><span class="eyebrow">ABOUT US</span><h2>關於雲橙</h2></div><div class="about-layout"><div class="about-copy"><h3>創辦人兼技術長 Mark Chen</h3><p>畢業於國立中正大學會計資訊學系，具備跨領域的財務邏輯與深厚後端架構實力。於 2013 年創立「雲橙工作室」，深耕客製化商業系統、ERP/進銷存流程整合、高可用電商架構與雲端伺服器維運逾十年。</p><p>不同於純技術導向的開發者，我們以「商業營運與帳務安全」為核心出發點，精準理解企業在金流對帳、稅務申報與進銷存等複雜流程的真實痛點。致力於為企業消滅人工重複作業與資安漏洞，打造高穩定、高擴充性且真正賦能業務成長的數位基礎架構。</p></div><div class="stats"><div class="stat"><span class="stat-value"><strong class="counter" data-from="0" data-to={years}>0</strong><span class="suffix">+年</span></span><span class="stat-title">深耕全端架構與系統維運</span><p>自 2013 年成立至今，走過網頁技術多次迭代，專注於為中小企業打造長久穩定、易於維護的數位營運基底。</p></div><div class="stat"><span class="stat-value"><strong class="counter" data-from="0" data-to="50">0</strong><span class="suffix">+個</span></span><span class="stat-title">跨領域商用專案實例</span><p>涵蓋品牌形象官網、高流量購物商城、製造業進銷存管理、企業財務記帳與跨平台 API 自動化串接系統。</p></div><div class="stat"><span class="stat-value"><strong class="counter" data-from="80" data-to="100">80</strong><span class="suffix">%</span></span><span class="stat-title">自研架構與客製掌握度</span><p>所有核心邏輯、資料庫結構與資安防護皆一手把關，未來擴充升級無痛不卡關。</p></div><div class="stat"><span class="stat-value"><strong class="counter" data-from="90" data-to="99.99">90</strong><span class="suffix">%</span></span><span class="stat-title">高可用營運與資安守護</span><p>全面部署 Cloudflare 雲端防護、伺服器即時效能監控與自動異地備份機制，確保關鍵商業系統 365 天不中斷。</p></div></div></div></section>
</Base>
<style>
.hero{min-height:650px;padding:140px 24px 130px;display:grid;place-items:center;text-align:center;color:white;position:relative;background:#222;overflow:hidden}.hero-collage{position:absolute;inset:0;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr);filter:grayscale(1);opacity:.55}.hero-collage:after{content:'';position:absolute;inset:0;background:#0009}.hero-collage img{width:100%;height:100%;object-fit:cover}.hero-copy{position:relative;z-index:1;max-width:1050px}.hero:after{content:'';position:absolute;z-index:2;width:100%;height:60px;bottom:-1px;left:0;background:#fff;clip-path:ellipse(56% 62% at 50% 100%)}.hero-copy>p{font-size:24px;font-weight:700;margin:14px}.hero h1{font-size:clamp(40px,6vw,70px);line-height:1.3;margin:14px auto 18px}.intro{max-width:790px;margin:0 auto 25px;font-size:16px;line-height:1.9;color:#eee}.services,.projects{padding:72px max(calc((100vw - 1180px)/2),6%) 90px}.section-title{margin-bottom:42px}.section-title h2{margin-top:8px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.service-card{padding:28px 25px;border:1px solid #eee;min-height:190px}.service-card.featured{background:#171717;color:white}.service-num{color:var(--orange);font-size:12px;letter-spacing:2px}.service-card h3{font-size:19px}.service-card p{font-size:14px;color:#777;line-height:1.9}.service-card.featured p{color:#ccc}.service-highlight{margin:0 0 22px;background:#fff8ed;border-left:4px solid var(--orange);padding:24px;display:flex;justify-content:space-between;gap:20px;align-items:center}.service-highlight>*{max-width:36%}.service-highlight span{font-size:14px;color:#666}.service-highlight b{font-size:18px}.projects{background:#f7f7f7}.project-tags{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:30px}.project-tags a{border:1px solid #ddd;background:white;border-radius:99px;padding:8px 16px;font-size:13px}.project-tags a:hover{background:var(--orange);color:white}.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.project-card{background:white}.project-card img{width:100%;aspect-ratio:1.5;object-fit:cover;background:#222;display:block}.project-card div{padding:17px}.project-card span{font-size:12px;color:#999}.project-card h3{margin:6px 0 0;font-size:17px}.more{margin:35px auto 0;display:flex;width:max-content}.about{max-width:1100px;margin:auto;padding:100px 24px;display:grid;grid-template-columns:1.1fr .9fr;gap:70px}.about h2{font-size:38px;margin:10px 0 22px}.about h3{font-size:18px}.about p{font-size:15px;line-height:2;color:#666}.stats{display:grid;grid-template-columns:1fr 1fr;gap:15px}.stats div{padding:28px 20px;background:#f7f7f7;display:flex;flex-direction:column}.stats b{font-size:43px;color:var(--orange)}.stats b span{font-size:23px}.stats small{font-size:13px;color:#777}@media(max-width:760px){.hero{min-height:600px}.services,.projects{padding:55px 20px}.service-grid,.project-grid{grid-template-columns:1fr 1fr}.service-highlight{display:grid}.service-highlight>*{max-width:unset}.about{grid-template-columns:1fr;gap:30px;padding:68px 24px}.about h2{font-size:31px}}@media(max-width:440px){.service-grid,.project-grid{grid-template-columns:1fr}.hero-copy>p{font-size:19px}.hero h1{font-size:39px}.stats div{padding:20px 14px}}
</style>
<style>
.hero{min-height:100vh;margin-top:-55px;background:url('/images/space.jpg') center center/cover no-repeat}.hero:after{display:none}.hero-curve{position:absolute;z-index:2;bottom:-1px;left:0;width:100%;height:100px;fill:#fff;transform:scaleY(-1)}.hero-copy{position:relative;z-index:3}.hero h1{font-size:clamp(40px,4.5vw,56px)}.intro{max-width:650px}.service-card h3{color:#f49d15}.service-icon{display:block;width:24px;height:24px;color:#f49d15;margin:0}.project-tags button{appearance:none;border:0;background:transparent;padding:10px 15px;color:#444;font:inherit;cursor:pointer}.project-tags button.active,.project-tags button:hover{color:#f49d15}.projects .project-grid{grid-template-columns:repeat(6,minmax(0,1fr));gap:20px}.projects .project-card{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;background:#eee}.projects .project-card[hidden]{display:none}.projects .project-card img{width:100%;height:100%;aspect-ratio:auto;object-fit:cover;display:block;transition:transform .3s}.projects .project-card:hover img{transform:scale(1.035)}.projects .project-card .project-overlay{position:absolute;inset:0;display:grid;place-items:center;background:rgba(0,0,0,.65);opacity:0;transition:opacity .2s;padding:15px}.projects .project-card:hover .project-overlay,.projects .project-card:focus-visible .project-overlay{opacity:1}.projects .project-card .project-overlay h3{margin:0;color:#fff;text-align:center;font-size:16px;font-weight:500}.about{display:block}.about-layout{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:30px}.about-title{margin-bottom:30px}.about .about-copy{position:relative;z-index:1;background:#fff;border-radius:20px;box-shadow:0 0 20px rgba(0,0,0,.1);padding:50px;margin-right:-25px}.about .stats{margin-left:-25px;margin-right:25px;padding:50px;background:#efefef;border-radius:20px;box-shadow:0 0 20px rgba(0,0,0,.1);grid-template-columns:repeat(2,minmax(0,1fr));gap:5% 2%}.about .stats .stat{position:relative;min-width:0;padding:5px 0 12px;background:transparent;display:grid;grid-template-columns:auto auto;justify-content:start;align-items:baseline;column-gap:5px}.about .stat-title{grid-column:1/-1;font-size:15px;font-weight:500}.about .stat .counter{font-size:36px;line-height:1.2;color:#f49d15;font-weight:600}.about .stat .suffix{font-size:16px;color:#333}.about .stat p{grid-column:1/-1;margin:6px 0 0;font-size:13px;line-height:1.7;color:#555}@media(max-width:1024px){.projects .project-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.about .about-copy{padding:30px;margin-right:-10px}.about .stats{margin-left:-10px;margin-right:0;padding:30px}}@media(max-width:767px){.hero{padding-top:125px}.hero h1{font-size:clamp(36px,8vw,48px)}.intro{max-width:90%}.hero-curve{height:70px}.about{padding:55px 24px 75px}.about-layout{grid-template-columns:1fr;gap:18px}.about .about-copy{margin:0;padding:30px}.about .stats{margin:0;padding:24px}.projects .project-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}}@media(max-width:440px){.projects .project-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.projects .project-overlay h3{font-size:13px}.about .stats{padding:18px;gap:16px 8px}.about .stat .counter{font-size:30px}}
</style>
<style>
.service-grid .service-icon-box{display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:9px;background:#f49d15}
.service-grid .service-card:not(:first-child) .service-icon-box .service-icon{display:block;box-sizing:border-box;width:24px;height:24px;padding:0;margin:0;background:transparent;filter:brightness(0) invert(1)}
.service-grid .service-card:first-child .service-logo{width:auto;height:48px;max-width:100%;object-fit:contain}
/* 作品格全寬化：.projects 左右 padding 歸零（縮排改掛標題/標籤），作品格直接左右 10px，不受捲軸寬度影響 */
.projects{padding-left:0;padding-right:0}
.projects .section-title,.projects .project-tags{margin-left:max(calc((100vw - 1180px) / 2), 6%);margin-right:max(calc((100vw - 1180px) / 2), 6%)}
.projects .project-grid{margin:0 10px}
.projects .project-grid .project-card>img{display:block;width:100%;max-width:none;height:100%;margin:0;padding:0;object-fit:cover}
.about .about-copy{position:relative;z-index:1}
.about .stats{position:relative;z-index:2;margin-left:-85px;margin-right:25px;transform:translate(55px,60px)}
@media(max-width:767px){.about .stats{margin:0;transform:none}}
.projects .project-grid .project-card{border-radius:10px;overflow:hidden}
.about .stat .suffix{font-size:15px;color:#f49d15}.about .stats .stat{grid-template-columns:max-content max-content;column-gap:5px}
.about .about-copy{padding-right:90px}
.about .stats{transform:translate(35px,60px)}
.about .stats .stat{grid-template-columns:minmax(0,1fr);min-width:0}
.about .stat-value{grid-column:1/-1;display:inline-flex;align-items:baseline;gap:4px;white-space:nowrap}
.about .stat-title,.about .stat p{grid-column:1/-1;min-width:0;overflow-wrap:anywhere}
@media(max-width:1024px){.about .about-copy{padding-right:60px}.about .stats{margin-left:-55px;margin-right:0;padding:30px;transform:translateY(40px)}}
@media(max-width:767px){.about .about-copy{padding:30px}.about .stats{margin:0;padding:24px;transform:none}}</style>
