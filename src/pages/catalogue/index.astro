---
import Base from '../../layouts/Base.astro';
import ProjectArchive from '../../components/ProjectArchive.astro';
import { getProjects, getCatalogues, routeSlug } from '../../lib/wordpress.js';
import { collectionSchema, breadcrumbSchema, siteUrl } from '../../lib/schema.js';
const projects = await getProjects().catch(() => []);
const catalogues = await getCatalogues().catch(() => []);
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const description = `瀏覽雲橙工作室的 ${projects.length} 個作品案例：WordPress、WooCommerce、Laravel 官網、購物網站與客製系統開發實績。`;
---
<Base title="作品分類｜雲橙網頁設計工作室" description={description} active="作品案例" jsonLd={[
  collectionSchema({
    title: '作品案例目錄｜雲橙工作室',
    description,
    url: pageUrl,
    items: catalogues.map((term) => ({ name: term.name, url: `${siteUrl}/catalogue/${routeSlug(term.slug)}/` })),
  }),
  breadcrumbSchema([
    { name: '首頁', url: `${siteUrl}/` },
    { name: '作品案例', url: `${siteUrl}/catalogue/` },
  ]),
]}><ProjectArchive projects={projects} catalogues={catalogues} /></Base>
